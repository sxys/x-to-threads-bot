# ================== Telegram 机器人配置 ==================
# 从 @BotFather 获取的 Token
TG_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
# 从 @userinfobot 获取的个人 Chat ID
TG_CHAT_ID=123456789

# ================== X (Twitter) 登录配置 ==================
# 方式 1【最推荐，极稳免风控】：从浏览器 F12 获取的 auth_token 和 ct0 (两项都填)
X_AUTH_TOKEN=
X_CT0=

# 方式 2：使用用户名密码登录（如果留空上面两项，则使用以下账号密码）
X_USERNAME=your_x_username
X_EMAIL=your_x_email@example.com
X_PASSWORD=your_x_password
COOKIE_FILE=x_cookies.json

# 流模式: for_you (主页推荐流，默认) 或 following (正在关注的人的最新流)
TIMELINE_TYPE=for_you

# ================== 抓取与热度权重配置 ==================
# 每次抓取选取的最高热度推文数量（每4小时抓一次，每次8条，一天6次共48条）
TOP_LIMIT=8
# 抓取间隔周期（小时，默认 4）
SCHEDULE_INTERVAL_HOURS=4
# 每条推文间隔发布时间（分钟，默认 30）
POST_INTERVAL_MINUTES=30
# 滚动翻页次数（每次约抓取 20-40 条候选，5 次约 100-150 条候选池）
FETCH_PAGES=5

# 热度得分公式各参数权重 (Score = 点赞*W + 转发*W + 评论*W + 引用*W)
WEIGHT_LIKE=1.0
WEIGHT_RETWEET=2.0
WEIGHT_REPLY=1.5
WEIGHT_QUOTE=1.5

# ================== 本地网络代理配置 ==================
# 国内环境访问 X 与 Telegram 必须走代理（如 Clash 默认 7890 端口）
# 若不需要代理请留空
PROXY=http://127.0.0.1:7890

# ================== 内容清洗与日记过滤配置 ==================
# 是否自动跳过博主第一人称真实生活日记、家庭琐事、就医相亲、感情纠葛流水账（true/false，默认 true）
FILTER_PERSONAL_DIARY=true
# 自定义排除关键词（以逗号分隔，包含这些词的推文将被自动跳过，可选）
EXCLUDE_KEYWORDS=
# 是否主动避开自残、自杀、进食障碍、暴力的内容，性暗示内容，以及宣传烟草等管制产品的内容（符合 Threads 推荐规范，true/false，默认 true）
FILTER_RESTRICTED_CONTENT=true
# 是否在入选前启用 Gemini AI 深度安全合规复核（true/false，默认 false，需要有效的 GEMINI_API_KEY）
FILTER_RESTRICTED_AI=false

# ================== 定时任务执行时间 ==================
# 每天定时执行的时和分（24小时制，例如 08:00）
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0

# ================== Gemini AI 智能互动与防风控配置 ==================
# Google AI Studio 申请的免费 API Key (https://aistudio.google.com/)
GEMINI_API_KEY=
# Gemini 语言模型（默认 gemini-2.5-flash-lite，速度极快且免费配额充足）
GEMINI_MODEL=gemini-2.5-flash-lite
# 拟人防风控随机间隔时间范围（秒，默认 35 到 75 秒，避免回复过于密集）
AUTO_REPLY_DELAY_MIN=35
AUTO_REPLY_DELAY_MAX=75
